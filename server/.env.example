# Vistaro Environment Variables Configuration
NODE_ENV=development
PORT=5000

# Security & Tokens
JWT_SECRET=replace_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_secret_in_production

# CORS Configuration (comma-separated or single domain)
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
# Used when connecting to live PostgreSQL database
DATABASE_URL=postgresql://username:password@localhost:5432/vistaro?schema=public

# Optional Contextual AI Assistant
# If provided, enables live LLM calls; otherwise falls back to deterministic in-app guidance
GEMINI_API_KEY=
